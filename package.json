{
  "name": "smart-shelter-client",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"next dev --turbopack --port 3300\" \"wait-on http://localhost:3300 && electron .\"",
    "build": "next build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false WIN_CSC_LINK= electron-builder --win",
    "start": "next start --port 3300",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3300 && electron .\"",
    "electron:build": "npm run build && npm run electron:pack",
    "electron:pack": "electron-builder --win",
    "electron:start": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.474.0",
    "msedge-tts": "^2.0.4",
    "next": "15.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.smart-shelter.client",
    "productName": "Smart-Shelter",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "server/**",
      "out/**"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
